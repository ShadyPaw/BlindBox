generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

enum CatalogMode {
  CONSUMER
  COIN
}

enum MoneyUnit {
  USD
  COIN
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum CompletenessStatus {
  COMPLETE
  INCOMPLETE
}

model CatalogBox {
  id                 String             @id
  sourceKey          String             @unique
  slug               String
  name               String
  description        String?
  image              String
  mode               CatalogMode
  category           String
  tags               String[]
  displayOrder       Int
  publicationStatus  PublicationStatus  @default(DRAFT)
  completenessStatus CompletenessStatus @default(INCOMPLETE)
  priceMinor         BigInt
  priceUnit          MoneyUnit
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  items              CatalogBoxItem[]

  @@unique([mode, slug])
  @@index([publicationStatus, mode, displayOrder, id])
  @@index([publicationStatus, mode, category, displayOrder, id])
  @@index([publicationStatus, mode, priceMinor, id])
}

model CatalogBoxItem {
  id                        String     @id
  sourceKey                 String     @unique
  boxId                     String
  box                       CatalogBox @relation(fields: [boxId], references: [id], onDelete: Restrict)
  name                      String
  image                     String
  displayOrder              Int
  displayValueMinor         BigInt
  displayValueUnit          MoneyUnit
  /// Reference display only. NEVER use for Opening Engine outcomes or weights.
  displayProbabilityPercent Decimal?   @db.Decimal(20, 12)
  createdAt                 DateTime   @default(now())
  updatedAt                 DateTime   @updatedAt

  @@index([boxId, displayOrder, id])
}

enum Role {
  USER
  ADMIN
}

model User {
  id             String               @id @default(cuid())
  email          String               @unique
  passwordHash   String
  role           Role                 @default(USER)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  sessions       Session[]
  resetTokens    PasswordResetToken[]
  walletAccounts WalletAccount[]
}

enum WalletAccountKind {
  USER
  CLEARING
}

enum WalletDirection {
  CREDIT
  DEBIT
}

model WalletAccount {
  id           String            @id
  kind         WalletAccountKind
  userId       String?
  user         User?             @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  unit         MoneyUnit
  /// Projection maintained only by the ledger INSERT trigger; never update directly.
  balanceMinor BigInt            @default(0)
  createdAt    DateTime          @default(now())
  outgoing     WalletTransfer[]  @relation("WalletOutgoing")
  incoming     WalletTransfer[]  @relation("WalletIncoming")

  @@unique([userId, unit])
}

/// An immutable, balanced pair: debit fromAccount and credit toAccount by the same amount/unit.
/// SQL triggers enforce posting, account consistency and immutability, including raw SQL writes.
model WalletTransfer {
  id                    String          @id
  sequence              BigInt          @unique @default(autoincrement())
  idempotencyKey        String          @unique
  requestHash           String
  referenceType         String
  referenceId           String
  direction             WalletDirection
  description           String
  unit                  MoneyUnit
  amountMinor           BigInt
  fromAccountId         String
  fromAccount           WalletAccount   @relation("WalletOutgoing", fields: [fromAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  toAccountId           String
  toAccount             WalletAccount   @relation("WalletIncoming", fields: [toAccountId], references: [id], onDelete: Restrict, onUpdate: Restrict)
  fromBalanceAfterMinor BigInt          @default(0)
  toBalanceAfterMinor   BigInt          @default(0)
  createdAt             DateTime        @default(now())

  @@unique([referenceType, referenceId, direction])
  @@index([fromAccountId, sequence])
  @@index([toAccountId, sequence])
}

model Session {
  tokenHash String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([userId])
  @@index([expiresAt])
}

model PasswordResetToken {
  tokenHash String    @id
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  @@index([userId])
  @@index([expiresAt])
}
